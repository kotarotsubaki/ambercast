{
  "$schema": "./node_modules/ambercast/dist/schema/config.schema.json",
  "testDir": "tests/ambercast",
  "targets": {
    "memos": {
      "baseUrl": "http://127.0.0.1:5230",
      "locale": "en-US"
    },
    "memos-readonly": {
      "baseUrl": "http://127.0.0.1:5230",
      "locale": "en-US",
      "healReplayIsolation": "idempotent"
    },
    "memos-ja": {
      "baseUrl": "http://127.0.0.1:5230",
      "locale": "ja-JP"
    }
  },
  "defaultTarget": "memos",
  "secrets": {
    "allow": [
      "password"
    ]
  },
  "heal": {
    "maxStepRepairs": 2
  }
}
