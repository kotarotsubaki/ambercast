{
  "rules": {
    "preset-ja-technical-writing": {
      "sentence-length": false,
      "no-mix-dearu-desumasu": {
        "preferInHeader": "である",
        "preferInBody": "である",
        "preferInList": "である"
      }
    },
    "@textlint-ja/preset-ai-writing": true
  },
  "plugins": {
    "mdx": true
  }
}
