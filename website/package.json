{
  "name": "ambercast-docs",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.14"
  },
  "scripts": {
    "sync": "node scripts/sync-spec.mjs && node scripts/sync-generated.mjs",
    "predev": "SYNC_OPTIONAL=1 npm run sync",
    "dev": "astro dev",
    "prebuild": "npm run sync",
    "build": "astro build",
    "postbuild": "node scripts/build-llms.mjs",
    "preview": "astro preview",
    "precheck": "npm run sync",
    "check": "node scripts/check-parity.mjs && node scripts/check-reference.mjs"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "7.3.1",
    "@astrojs/mdx": "8.0.1",
    "@astrojs/starlight": "0.42.0",
    "astro": "7.3.2"
  }
}
