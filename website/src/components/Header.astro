---
import LanguageSelect from '@astrojs/starlight/components/LanguageSelect.astro';
import Search from '@astrojs/starlight/components/Search.astro';
import SocialIcons from '@astrojs/starlight/components/SocialIcons.astro';
import ThemeSelect from '@astrojs/starlight/components/ThemeSelect.astro';
import SiteTitle from './SiteTitle.astro';
import { npmVersion } from '../data/site-meta.ts';

const locale = Astro.locals.starlightRoute.locale;
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const documentationHrefs = {
  ja: `${base}ja/introduction/`,
  'zh-cn': `${base}zh-cn/introduction/`,
  en: `${base}introduction/`,
};
const docsByLocale = {
  ja: { href: documentationHrefs.ja, label: 'ドキュメント' },
  'zh-cn': { href: documentationHrefs['zh-cn'], label: '文档' },
  en: { href: documentationHrefs.en, label: 'Docs' },
};
const docs = docsByLocale[locale ?? 'en'] ?? docsByLocale.en;
---

<!-- Search, social links, theme and language controls retain Starlight's own behavior; PageFrame continues to own the mobile-menu toggle. -->
<div class="header ac-header">
  <div class="title-wrapper"><SiteTitle /></div>
  <div class="ac-header-search"><Search /></div>
  <div class="ac-header-controls">
    <!-- Landing routes have no sidebar, so this permanent header link keeps the documentation reachable in every locale. -->
    <a class="ac-docs-link" href={docs.href} aria-label={docs.label}><span class="ac-docs-label">{docs.label}</span><span class="ac-docs-label-short" aria-hidden="true">Docs</span></a>
    <span class="ac-version">v{npmVersion}</span>
    <div class="social-icons"><SocialIcons /></div>
    <ThemeSelect />
    <LanguageSelect />
  </div>
</div>
