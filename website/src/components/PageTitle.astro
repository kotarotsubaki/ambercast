---
import DefaultPageTitle from '@astrojs/starlight/components/PageTitle.astro';
import { getPageLocation } from '../sidebar.mjs';

// Route parsing keeps locale prefixes out of the navigation key. The label derives its group
// and ordinal from getPageLocation so Starlight's sidebar remains the sole page-order authority.
// Pages outside that navigation, such as landing pages, use the GUIDES · NO. 01 fallback
// rather than an invented sidebar location.
const { entry } = Astro.locals.starlightRoute;
const routeParts = entry.id.split('/');
const localeOffset = routeParts[0] === 'ja' || routeParts[0] === 'zh-cn' ? 1 : 0;
const slug = routeParts.slice(localeOffset).join('/');
const location = getPageLocation(slug);
const section = location?.groupLabel ?? 'GUIDES';
const pageNumber = String(location?.indexInGroup ?? 1).padStart(2, '0');
const specimenTitle = slug.split('/').at(-1)?.replaceAll('-', ' ') ?? entry.data.title;
---

<!-- Starlight owns the route title and anchor; the ASCII specimen index stays language-neutral in every locale. -->
<div class="ac-page-title">
  <p class="ac-label">{section} · NO. {pageNumber} · {specimenTitle}</p>
  <DefaultPageTitle />
  {entry.data.description && <p class="ac-page-lead">{entry.data.description}</p>}
</div>
