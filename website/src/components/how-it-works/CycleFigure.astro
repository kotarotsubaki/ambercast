---
import Figure from './Figure.astro';
import { NODE_EMPHASIS } from './emphasis.mjs';

/**
 * Describes one localized node in the fixed five-node cycle. The `run` record carries the
 * replay-on-hit, zero-AI meaning in its own label and text, avoiding a sixth `replay` node or a new
 * component prop solely for presentation.
 */
interface CycleNode {
  id: string;
  label: string;
  text: string;
}

/**
 * Describes one of the five directed relationships in the cycle. The data contract permits only
 * forward edges, so the renderer does not need a bidirectional rendering branch.
 */
interface CycleEdge {
  from: string;
  to: string;
  label: string;
  direction: 'forward';
}

/**
 * Supplies the localized data and accessible description for the fixed five-node cycle figure.
 *
 * @remarks
 * The component keeps the `.intro-*` selector family rather than renaming it: the classes are an
 * already-styled, stable naming scheme shared by `Figure.astro`, and renaming them for this
 * visual-only change would ripple into markup-coupled tests for no rendering benefit. Its
 * five-node, five-edge graph remains the accepted functional scope; only how those five nodes and
 * edges are arranged and drawn changes here.
 */
interface Props {
  nodes: CycleNode[];
  edges: CycleEdge[];
  alt: string;
  caption: string | null;
}

const { nodes, edges, alt, caption } = Astro.props;

/**
 * Resolves a required node before the fixed graph is rendered.
 *
 * Returning an optional value would let incomplete locale data produce a plausible but partial
 * cycle. The implementation instead fails loudly when a required id is absent.
 *
 * @param id Required node id.
 * @returns The matching cycle node.
 * @throws If the fixed graph does not contain the requested node.
 */
function getNode(id: string): CycleNode {
  const node = nodes.find((candidate) => candidate.id === id);
  if (!node) throw new Error(`Missing cycle node: ${id}`);
  return node;
}

/**
 * Resolves a required directed edge before the fixed graph is rendered.
 *
 * The implementation deliberately throws for a missing relationship so malformed data cannot
 * silently erase part of the generate-run-heal cycle while leaving the rest apparently valid.
 *
 * @param from Required source node id.
 * @param to Required destination node id.
 * @param direction Required edge direction.
 * @returns The matching cycle edge.
 * @throws If the fixed graph does not contain the requested edge.
 */
function getEdge(from: string, to: string, direction: CycleEdge['direction']): CycleEdge {
  const edge = edges.find(
    (candidate) => candidate.from === from && candidate.to === to && candidate.direction === direction,
  );
  if (!edge) throw new Error(`Missing cycle edge: ${from} -> ${to} (${direction})`);
  return edge;
}

function nodeClass(node: CycleNode): string {
  const emphasis = NODE_EMPHASIS[node.id as keyof typeof NODE_EMPHASIS];
  return emphasis ? `intro-node intro-node-${emphasis}` : 'intro-node';
}

const prompt = getNode('prompt');
const generate = getNode('generate');
const artifacts = getNode('artifacts');
const run = getNode('run');
const heal = getNode('heal');
const promptToGenerate = getEdge('prompt', 'generate', 'forward');
const generateToArtifacts = getEdge('generate', 'artifacts', 'forward');
const artifactsToRun = getEdge('artifacts', 'run', 'forward');
const runToHeal = getEdge('run', 'heal', 'forward');
const healToArtifacts = getEdge('heal', 'artifacts', 'forward');
---

<!--
  Layout intent (grid-area names below map onto `.intro-cycle-flow`'s grid-template-areas in
  custom.css): `artifacts` is the hub both directed paths pass through, so it receives an arrow
  from `generate` above and, on the return leg, from `heal` below, while feeding `run` to its
  right. Sharing one node between the forward and return paths is what makes the cycle read as one
  connected loop rather than a row of boxes with a caption underneath.

  Exactly one edge has endpoints that are not grid-adjacent at any given breakpoint — `run`→`heal`
  on this (desktop) layout, `heal`→`artifacts` once the column collapses at ≤26rem, since a single
  column no longer has room to loop back. That one edge renders as a single spanning element
  (`.intro-cycle-return`, styled in custom.css to draw both segments of the turn) rather than two
  independent arrow cells, so the corner reads as one continuous line and `runToHeal.label` is
  never read twice.
-->
<Figure alt={alt} caption={caption}>
  <div class="intro-cycle-flow">
    <div class={nodeClass(prompt)} style="grid-area: prompt">
      <strong>{prompt.label}</strong>
      <span>{prompt.text}</span>
    </div>
    <div class="intro-arrow" style="grid-area: prompt-to-generate">→ {promptToGenerate.label}</div>
    <div class={nodeClass(generate)} style="grid-area: generate">
      <strong>{generate.label}</strong>
      <span>{generate.text}</span>
    </div>
    <div class="intro-arrow" style="grid-area: generate-to-artifacts">↓ {generateToArtifacts.label}</div>
    <div class={nodeClass(artifacts)} style="grid-area: artifacts">
      <strong>{artifacts.label}</strong>
      <span>{artifacts.text}</span>
    </div>
    <div class="intro-arrow" style="grid-area: artifacts-to-run">→ {artifactsToRun.label}</div>
    <div class={nodeClass(run)} style="grid-area: run">
      <strong>{run.label}</strong>
      <span>{run.text}</span>
    </div>
    <!--
      The one non-adjacent edge (see the layout-intent note above): a single element spans both
      grid tracks it needs to cross, and custom.css draws its corner (a vertical drop from `run`,
      then a horizontal run into `heal`) as an actual pair of border lines on the element itself
      rather than relying on arrow glyphs alone — text a few rows away from either node it names
      does not read as "connected" without a visible line joining them. At the ≤26rem breakpoint
      the element collapses back to a single adjacent grid cell like any other arrow, where
      custom.css removes the corner lines rather than drawing a corner with nothing to turn. Two
      glyph spans (rather than one glyph swapped by breakpoint) match the direction each layout
      actually draws: `←` for the corner's final, horizontal leg into `heal` on the desktop hub,
      `↓` for the plain vertical step down to `heal` once the column collapses — the same
      direction-matches-glyph convention `generate`→`artifacts`'s `↓` and `heal`→`artifacts`'s `↑`
      already use elsewhere in this figure.
    -->
    <div class="intro-cycle-return" style="grid-area: run-to-heal">
      <span class="intro-cycle-return-glyph-wide">←</span><span class="intro-cycle-return-glyph-narrow">↓</span> {runToHeal.label}
    </div>
    <div class={nodeClass(heal)} style="grid-area: heal">
      <strong>{heal.label}</strong>
      <span>{heal.text}</span>
    </div>
    <!--
      Adjacent (straight vertical arrow) at the desktop hub layout; custom.css reshapes this same
      element into the spanning return connector at ≤26rem, where it is `run`→`heal` that becomes
      adjacent instead. One element serves both roles so the DOM/accessible tree never duplicates
      an edge just because its visual treatment differs per breakpoint.
    -->
    <div class="intro-arrow intro-cycle-return-at-narrow" style="grid-area: heal-to-artifacts">↑ {healToArtifacts.label}</div>
  </div>
</Figure>
