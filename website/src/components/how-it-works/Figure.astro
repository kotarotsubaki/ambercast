---
/**
 * Supplies the figure's accessible description and optional visible caption.
 *
 * The outer figure owns `alt` as its spoken description so repeated labels inside the visual
 * flow do not compete with it. The flow is hidden from assistive technology, while a non-null
 * caption remains a direct `figcaption` child of the figure to preserve their semantic and
 * visual relationship.
 */
interface Props {
  alt: string;
  caption: string | null;
}

const { alt, caption } = Astro.props;

// The figure owns the accessible description so repeated visual labels do not create a
// competing spoken description. Keeping the caption outside the hidden flow preserves the
// figure/figcaption relationship.
---

<figure class="intro-figure" role="img" aria-label={alt}>
  <div class="intro-flow" aria-hidden="true">
    <slot />
  </div>
  {caption !== null && <figcaption class="intro-caption" aria-hidden="true">{caption}</figcaption>}
</figure>
