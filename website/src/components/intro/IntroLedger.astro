---
import IntroFigure from './IntroFigure.astro';
import { NODE_EMPHASIS } from './emphasis.mjs';

interface IntroNode {
  id: string;
  label: string;
  text: string;
}

interface IntroEdge {
  from: string;
  to: string;
  label: string;
  direction: 'forward' | 'bidirectional';
}

interface Props {
  nodes: IntroNode[];
  edges: IntroEdge[];
  alt: string;
  caption: string | null;
}

const { nodes, edges, alt, caption } = Astro.props;

// Explicit opposing glyphs distinguish repair from the authorized return while keeping both
// edges attached to the same node pair. Resolving the fixed graph shape before rendering makes
// a changed edge direction a data error rather than a misleading visual detail.
function getNode(id: string): IntroNode {
  const node = nodes.find((candidate) => candidate.id === id);
  if (!node) throw new Error(`Missing ledger node: ${id}`);
  return node;
}

function getEdge(from: string, to: string, direction: IntroEdge['direction']): IntroEdge {
  const edge = edges.find(
    (candidate) => candidate.from === from && candidate.to === to && candidate.direction === direction,
  );
  if (!edge) throw new Error(`Missing ledger edge: ${from} -> ${to} (${direction})`);
  return edge;
}

function nodeClass(node: IntroNode): string {
  const emphasis = NODE_EMPHASIS[node.id as keyof typeof NODE_EMPHASIS];
  return emphasis ? `intro-node intro-node-${emphasis}` : 'intro-node';
}

const generate = getNode('generate');
const replay = getNode('replay');
const heal = getNode('heal');
const generateToReplay = getEdge('generate', 'replay', 'forward');
const replayToHeal = getEdge('replay', 'heal', 'forward');
const healToReplay = getEdge('heal', 'replay', 'forward');
---

<IntroFigure alt={alt} caption={caption}>
  <div class="intro-ledger-flow">
    <div class={nodeClass(generate)} style="grid-area: generate">
      <strong>{generate.label}</strong>
      <span>{generate.text}</span>
    </div>
    <div class="intro-arrow" style="grid-area: generate-to-replay">→ {generateToReplay.label}</div>
    <div class={nodeClass(replay)} style="grid-area: replay">
      <strong>{replay.label}</strong>
      <span>{replay.text}</span>
    </div>
    <div style="grid-area: replay-heal-connectors">
      <div class="intro-arrow">→ {replayToHeal.label}</div>
      <div class="intro-arrow">← {healToReplay.label}</div>
    </div>
    <div class={nodeClass(heal)} style="grid-area: heal">
      <strong>{heal.label}</strong>
      <span>{heal.text}</span>
    </div>
  </div>
</IntroFigure>
